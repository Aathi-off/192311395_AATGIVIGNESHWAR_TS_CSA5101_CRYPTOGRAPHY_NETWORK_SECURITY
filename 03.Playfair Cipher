#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

/* Create the 5 x 5 Playfair matrix */
void generateMatrix(char key[]) {
    int used[26] = {0};
    int row = 0, col = 0;
    int i;
    char ch;

    // Combine I and J
    used['J' - 'A'] = 1;

    // Insert key characters
    for (i = 0; key[i] != '\0'; i++) {
        ch = toupper(key[i]);

        if (ch < 'A' || ch > 'Z')
            continue;

        if (ch == 'J')
            ch = 'I';

        if (!used[ch - 'A']) {
            matrix[row][col] = ch;
            used[ch - 'A'] = 1;

            col++;
            if (col == 5) {
                col = 0;
                row++;
            }
        }
    }

    // Fill remaining letters
    for (ch = 'A'; ch <= 'Z'; ch++) {
        if (!used[ch - 'A']) {
            matrix[row][col] = ch;
            used[ch - 'A'] = 1;

            col++;
            if (col == 5) {
                col = 0;
                row++;
            }
        }
    }
}

/* Find the position of a character */
void findPosition(char ch, int *row, int *col) {
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

/* Encrypt a pair of characters */
void encryptPair(char a, char b, char *x, char *y) {
    int row1, col1, row2, col2;

    findPosition(a, &row1, &col1);
    findPosition(b, &row2, &col2);

    // Same row
    if (row1 == row2) {
        *x = matrix[row1][(col1 + 1) % 5];
        *y = matrix[row2][(col2 + 1) % 5];
    }

    // Same column
    else if (col1 == col2) {
        *x = matrix[(row1 + 1) % 5][col1];
        *y = matrix[(row2 + 1) % 5][col2];
    }

    // Rectangle rule
    else {
        *x = matrix[row1][col2];
        *y = matrix[row2][col1];
    }
}

int main() {
    char key[100];
    char plaintext[200];
    char prepared[200];
    char ciphertext[200];

    int i, j = 0;
    char a, b;

    printf("Enter the keyword: ");
    scanf("%s", key);

    generateMatrix(key);

    printf("\nPlayfair Matrix:\n");
    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            printf("%c ", matrix[i][j]);
        }
        printf("\n");
    }

    printf("\nEnter plaintext: ");
    scanf(" %[^\n]", plaintext);

    // Prepare plaintext
    // Remove spaces and replace J with I
    j = 0;

    for (i = 0; plaintext[i] != '\0'; i++) {
        if (isalpha(plaintext[i])) {
            a = toupper(plaintext[i]);

            if (a == 'J')
                a = 'I';

            prepared[j++] = a;
        }
    }

    prepared[j] = '\0';

    // Insert X between repeated letters
    // and add X if length is odd
    j = 0;

    for (i = 0; prepared[i] != '\0'; i++) {
        ciphertext[j++] = prepared[i];

        if (prepared[i] == prepared[i + 1] &&
            prepared[i] != '\0') {
            ciphertext[j++] = 'X';
        }
    }

    if (j % 2 != 0)
        ciphertext[j++] = 'X';

    ciphertext[j] = '\0';

    // Encrypt pairs
    for (i = 0; i < j; i += 2) {
        encryptPair(
            ciphertext[i],
            ciphertext[i + 1],
            &a,
            &b
        );

        ciphertext[i] = a;
        ciphertext[i + 1] = b;
    }

    ciphertext[j] = '\0';

    printf("\nEncrypted Text: %s\n", ciphertext);

    return 0;
}
