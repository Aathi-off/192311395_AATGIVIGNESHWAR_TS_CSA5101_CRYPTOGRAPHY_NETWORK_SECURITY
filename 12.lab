#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char p[] = "meet me at the usual place at ten rather than eight oclock";
    int K[2][2]={{9,4},{5,7}}, D[2][2];
    int a,b,det,inv,i;
    char c[100], out[100];
    int n=0;

    for(i=0;p[i];i++)
        if(isalpha(p[i]))
            c[n++]=tolower(p[i])- 'a';
    if(n%2) c[n++]=23;

    printf("Plaintext: ");
    for(i=0;i<n;i+=2) {
        a=c[i]; b=c[i+1];
        printf("%c%c", (9*a+4*b)%26+'a',
                       (5*a+7*b)%26+'a');
    }

    det=(9*7-4*5)%26;
    for(i=1;i<26;i++)
        if((det*i)%26==1) inv=i;

    D[0][0]=7*inv%26;
    D[0][1]=-4*inv%26;
    D[1][0]=-5*inv%26;
    D[1][1]=9*inv%26;

    printf("\nDecrypted: ");
    for(i=0;i<n;i+=2) {
        a=(D[0][0]*c[i]+D[0][1]*c[i+1])%26;
        b=(D[1][0]*c[i]+D[1][1]*c[i+1])%26;
        if(a<0)a+=26; if(b<0)b+=26;
        out[i]=a+'a'; out[i+1]=b+'a';
    }

    for(i=0;i<n;i++) printf("%c",out[i]);
    return 0;
}
