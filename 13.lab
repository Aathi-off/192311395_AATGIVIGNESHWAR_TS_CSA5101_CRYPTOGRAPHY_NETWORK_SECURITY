#include <stdio.h>

int main() {
    int P[2][2], C[2][2], inv, det;
    int K[2][2];

    printf("Enter plaintext matrix:\n");
    for(int i=0;i<2;i++)
        for(int j=0;j<2;j++) scanf("%d",&P[i][j]);

    printf("Enter ciphertext matrix:\n");
    for(int i=0;i<2;i++)
        for(int j=0;j<2;j++) scanf("%d",&C[i][j]);

    det=(P[0][0]*P[1][1]-P[0][1]*P[1][0])%26;
    if(det<0) det+=26;

    for(inv=1;inv<26;inv++)
        if(det*inv%26==1) break;

    if(inv==26) {
        printf("Invalid plaintext matrix\n");
        return 0;
    }

    /* K = C * inverse(P) mod 26 */
    K[0][0]=(C[0][0]*P[1][1]-C[0][1]*P[1][0])*inv%26;
    K[0][1]=(-C[0][0]*P[0][1]+C[0][1]*P[0][0])*inv%26;
    K[1][0]=(C[1][0]*P[1][1]-C[1][1]*P[1][0])*inv%26;
    K[1][1]=(-C[1][0]*P[0][1]+C[1][1]*P[0][0])*inv%26;

    printf("Recovered Key:\n");
    for(int i=0;i<2;i++) {
        for(int j=0;j<2;j++) {
            if(K[i][j]<0) K[i][j]+=26;
            printf("%d ",K[i][j]);
        }
        printf("\n");
    }

    return 0;
}
