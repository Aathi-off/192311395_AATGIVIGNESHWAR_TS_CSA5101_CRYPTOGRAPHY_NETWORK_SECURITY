#include <stdio.h>

int main() {
    char p[100];
    int key[100], n, i;

    printf("Enter plaintext: ");
    scanf("%s",p);

    printf("Enter length: ");
    scanf("%d",&n);

    printf("Enter random key values (0-25): ");
    for(i=0;i<n;i++)
        scanf("%d",&key[i]);

    printf("Ciphertext: ");
    for(i=0;p[i];i++)
        printf("%c",((p[i]-'a'+key[i])%26)+'a');

    return 0;
}
