#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char c[500], p[500];
    int freq[26] = {0}, n = 0, i, j, shift;

    printf("Enter ciphertext: ");
    fgets(c, sizeof(c), stdin);

    for(i = 0; c[i]; i++)
        if(isalpha(c[i])) {
            c[n++] = tolower(c[i]);
            freq[c[n-1]-'a']++;
        }

    printf("\nPossible plaintexts:\n");

    for(shift = 0; shift < 26; shift++) {
        printf("Shift %2d: ", shift);

        for(j = 0; j < n; j++) {
            p[j] = (c[j] - 'a' - shift + 26) % 26 + 'a';
            putchar(p[j]);
        }
        printf("\n");
    }

    return 0;
}
