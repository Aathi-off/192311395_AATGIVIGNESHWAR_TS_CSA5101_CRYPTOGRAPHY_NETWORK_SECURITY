#include <stdio.h>

void generateKeys(unsigned long long key,
                  unsigned long long k[16]) {
    int i;

    /* Simplified educational key generation */
    for(i = 0; i < 16; i++)
        k[i] = key ^ (0x1111111111111111ULL * (i + 1));
}

unsigned long long desDecrypt(unsigned long long block,
                               unsigned long long key) {
    unsigned long long k[16], temp;
    int i;

    generateKeys(key, k);

    printf("DES Decryption Key Order:\n");

    for(i = 15; i >= 0; i--)
        printf("K%d = %016llX\n", i + 1, k[i]);

    temp = block;

    for(i = 15; i >= 0; i--)
        temp ^= k[i];

    return temp;
}

int main() {
    unsigned long long block, key, result;

    printf("Enter 64-bit ciphertext (hex): ");
    scanf("%llx", &block);

    printf("Enter 64-bit key (hex): ");
    scanf("%llx", &key);

    result = desDecrypt(block, key);

    printf("Decrypted block = %016llX\n", result);

    return 0;
}
