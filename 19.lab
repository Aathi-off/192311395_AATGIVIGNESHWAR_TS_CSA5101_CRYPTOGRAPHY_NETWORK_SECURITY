#include <stdio.h>

void encryptBlock(unsigned char *p,
                  unsigned char *k,
                  unsigned char *c) {
    int i;

    for(i = 0; i < 8; i++)
        c[i] = p[i] ^ k[i];
}

int main() {
    unsigned char p[100], c[100], iv[8], key[8];
    int n, i, j;

    printf("Enter plaintext: ");
    scanf("%s", p);

    printf("Enter 8-byte key: ");
    scanf("%8s", key);

    printf("Enter 8-byte IV: ");
    scanf("%8s", iv);

    n = 0;
    while(p[n] != '\0')
        n++;

    /* Padding */
    while(n % 8 != 0)
        p[n++] = 'X';

    for(i = 0; i < n; i += 8) {

        for(j = 0; j < 8; j++)
            p[i+j] ^= iv[j];

        encryptBlock(&p[i], key, &c[i]);

        for(j = 0; j < 8; j++)
            iv[j] = c[i+j];
    }

    printf("Ciphertext: ");

    for(i = 0; i < n; i++)
        printf("%02X", c[i]);

    printf("\n");

    return 0;
}
